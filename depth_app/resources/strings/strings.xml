<strings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <string id="AppName">Depth</string>

    <!--
        On-screen labels. All of these are drawn centred into a fixed slot on a
        round display, so a translation much longer than the English is clipped
        rather than wrapped. LabelDives and LabelBottomTime are the tightest:
        they sit beside their value on a single row, inside the round screen.
        Keep them short.
    -->
    <string id="LabelDepth">DEPTH</string>
    <string id="LabelMax">MAX</string>
    <string id="LabelSession">SESSION</string>
    <string id="LabelLastSession">LAST SESSION</string>
    <string id="LabelDives">DIVES</string>
    <string id="LabelBottomTime">BOTTOM</string>

    <!--
        Glance labels. scope="glance" is required, not tidiness: without it Rez
        is not visible from glance code at all and the build fails with "Value
        'Rez' not available in all function scopes". These two are measured at
        run time to align the values after them, so their length is free.
    -->
    <string id="GlanceDepth" scope="glance">Depth</string>
    <string id="GlanceMaxDepth" scope="glance">Max Depth</string>

    <string id="RezeroConfirm">Re-zero depth?</string>

    <string id="WaterTypeTitle">Water type</string>
    <string id="WaterTypePrompt">Salt water is denser, so the same depth reads as more pressure. Salt uses the 1 msw = 10000 Pa convention that dive computers use.</string>
    <string id="WaterFresh">Fresh</string>
    <string id="WaterSalt">Salt</string>

    <string id="UnitsTitle">Units</string>
    <string id="UnitsPrompt">Which units to show the depth in.</string>
    <string id="UnitsAuto">Follow watch</string>
    <string id="UnitsMetric">Meters</string>
    <string id="UnitsStatute">Feet</string>

    <!--
        The band edges are given in both units because this list is rendered by
        the phone, which cannot know what the Units setting is set to. They are
        one depth shown two ways, not two sets of thresholds: the feet figures
        are the metres rounded to whole feet.
    -->
    <string id="ColorProfileTitle">Colour range</string>
    <string id="ColorProfilePrompt">Which depths the colour of the reading spans, so it can be judged without reading the number. Blue, then green, yellow and red. Each range is a fixed depth whichever unit is displayed; the feet are the same depths rounded.</string>
    <string id="ProfileSnorkel">Snorkel (2/5/10 m, 7/16/33 ft)</string>
    <string id="ProfileFreedive">Freedive (10/20/30 m, 33/66/98 ft)</string>
    <string id="ProfileDeep">Deep (20/40/60 m, 66/131/197 ft)</string>

    <!--
        Both units again, and for the same reason as the colour ranges: the
        phone renders this list and cannot know what Units is set to.

        The five entries carry no words, and are repeated verbatim in every
        language all the same. A settings string missing from a language does
        not fall back to this file: the resource compiler warns "String id ...
        undefined for language" and the phone has nothing to label the entry
        with.
    -->
    <string id="DiveThresholdTitle">Dive threshold</string>
    <string id="DiveThresholdPrompt">How deep counts as a dive, for the dive count and bottom time on the Last Session page. A dive ends once you come back up past half this depth, so bobbing at the surface is not counted as diving.</string>
    <string id="DiveThreshold05">0.5 m (1.6 ft)</string>
    <string id="DiveThreshold10">1.0 m (3.3 ft)</string>
    <string id="DiveThreshold15">1.5 m (4.9 ft)</string>
    <string id="DiveThreshold20">2.0 m (6.6 ft)</string>
    <string id="DiveThreshold30">3.0 m (9.8 ft)</string>

    <string id="RezeroTitle">Re-zero depth</string>
    <string id="RezeroPrompt">Discards the surface pressure baseline and the maximum, and starts measuring again. Switches itself back off. Use it if measuring started while the watch was already in the water.</string>
</strings>
