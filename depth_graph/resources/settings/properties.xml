<properties>
    <!-- 0 = fresh, 1 = salt. See DepthModel.WATER_* -->
    <property id="waterType" type="number">0</property>
    <!-- 0 = follow the watch, 1 = meters, 2 = feet. See DepthModel.UNITS_* -->
    <property id="unitOverride" type="number">0</property>
    <!-- A trigger, not a state: the app acts on it and switches it back off. -->
    <property id="rezero" type="boolean">false</property>
    <!-- 0 = snorkel, 1 = freedive, 2 = deep. See DepthCore.PROFILE_*. The graph field
         colours both the reading and the trace, so it declares it too. -->
    <property id="colorProfile" type="number">0</property>
    <!-- 0 = chart, 1 = gauge. See depth_graphView.STYLE_*. This one is the
         graph field's alone: how it draws itself is no business of the depth
         model the other apps share. -->
    <property id="fieldStyle" type="number">0</property>
</properties>
