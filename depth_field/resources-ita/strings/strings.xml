<strings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!--
        Italian. AppName is deliberately left untranslated: it is the app's
        identity in the store and in the data field picker, not a label.

        FieldLabel gets the unit appended to it in code, so it carries no "(m)"
        or "(ft)" of its own. Data field labels get very little width - keep it
        short.
    -->
    <string id="AppName">Depth</string>

    <string id="WaterTypeTitle">Tipo di acqua</string>
    <string id="WaterTypePrompt">L'acqua salata è più densa, quindi la stessa profondità produce più pressione. Salata usa la convenzione 1 msw = 10000 Pa, la stessa dei computer subacquei.</string>
    <string id="WaterFresh">Dolce</string>
    <string id="WaterSalt">Salata</string>

    <string id="UnitsTitle">Unità</string>
    <string id="UnitsPrompt">In quale unità mostrare la profondità.</string>
    <string id="UnitsAuto">Segui l'orologio</string>
    <string id="UnitsMetric">Metri</string>
    <string id="UnitsStatute">Piedi</string>

    <string id="RezeroTitle">Azzera profondità</string>
    <string id="RezeroPrompt">Elimina la pressione di riferimento in superficie e il massimo, e ricomincia a misurare. Usalo se l'attività è iniziata con l'orologio già in acqua. Si disattiva da solo.</string>

    <string id="FieldLabel">Profondità</string>

    <string id="DiveThresholdTitle">Soglia di immersione</string>
    <string id="DiveThresholdPrompt">Da quale profondità viene contata un'immersione, per il numero di immersioni e il tempo di fondo registrati nell'attività. Un'immersione termina quando risali oltre la metà di questa profondità, così il moto ondoso non viene contato come immersione.</string>
    <string id="DiveThreshold05">0.5 m (1.6 ft)</string>
    <string id="DiveThreshold10">1.0 m (3.3 ft)</string>
    <string id="DiveThreshold15">1.5 m (4.9 ft)</string>
    <string id="DiveThreshold20">2.0 m (6.6 ft)</string>
    <string id="DiveThreshold30">3.0 m (9.8 ft)</string>
</strings>
