project.manifest = manifest.xml
project.typecheck = 3

# Launcher icons. The resource compiler rasterises an SVG at the size it
# declares and then rescales that bitmap to whatever the device asks for, so
# each device is pointed at a copy of the icon declared at its own launcher
# size and nothing is resampled. Sizes come from <device>/compiler.json.
instinctcrossoveramoled.resourcePath = $(instinctcrossoveramoled.resourcePath);resources-icon-38
fenix7.resourcePath = $(fenix7.resourcePath);resources-icon-40
fenix7pro.resourcePath = $(fenix7pro.resourcePath);resources-icon-40
fenix7pronowifi.resourcePath = $(fenix7pronowifi.resourcePath);resources-icon-40
fenix7s.resourcePath = $(fenix7s.resourcePath);resources-icon-40
fenix7spro.resourcePath = $(fenix7spro.resourcePath);resources-icon-40
fenix7x.resourcePath = $(fenix7x.resourcePath);resources-icon-40
fenix7xpro.resourcePath = $(fenix7xpro.resourcePath);resources-icon-40
fenix7xpronowifi.resourcePath = $(fenix7xpronowifi.resourcePath);resources-icon-40
fenix8solar47mm.resourcePath = $(fenix8solar47mm.resourcePath);resources-icon-40
fenix8solar51mm.resourcePath = $(fenix8solar51mm.resourcePath);resources-icon-40
instincte40mm.resourcePath = $(instincte40mm.resourcePath);resources-icon-52
epix2.resourcePath = $(epix2.resourcePath);resources-icon-60
epix2pro42mm.resourcePath = $(epix2pro42mm.resourcePath);resources-icon-60
epix2pro47mm.resourcePath = $(epix2pro47mm.resourcePath);resources-icon-60
epix2pro51mm.resourcePath = $(epix2pro51mm.resourcePath);resources-icon-60
fenix843mm.resourcePath = $(fenix843mm.resourcePath);resources-icon-60
instinct3amoled45mm.resourcePath = $(instinct3amoled45mm.resourcePath);resources-icon-60
instinct3amoled50mm.resourcePath = $(instinct3amoled50mm.resourcePath);resources-icon-60
marq2.resourcePath = $(marq2.resourcePath);resources-icon-60
