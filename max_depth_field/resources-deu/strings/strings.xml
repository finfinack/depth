<strings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <!--
        German. AppName is deliberately left untranslated: it is the app's
        identity in the store and in the data field picker, not a label.

        FieldLabel gets the unit appended to it in code, so it carries no "(m)"
        or "(ft)" of its own. Data field labels get very little width - keep it
        short.
    -->
    <string id="AppName">Max Depth</string>

    <string id="WaterTypeTitle">Wasserart</string>
    <string id="WaterTypePrompt">Salzwasser ist dichter, dieselbe Tiefe ergibt also mehr Druck. Salzwasser verwendet die Konvention 1 msw = 10000 Pa, mit der auch Tauchcomputer rechnen.</string>
    <string id="WaterFresh">Süsswasser</string>
    <string id="WaterSalt">Salzwasser</string>

    <string id="UnitsTitle">Einheiten</string>
    <string id="UnitsPrompt">In welcher Einheit die Tiefe angezeigt wird.</string>
    <string id="UnitsAuto">Uhr folgen</string>
    <string id="UnitsMetric">Meter</string>
    <string id="UnitsStatute">Fuss</string>

    <string id="RezeroTitle">Tiefe zurücksetzen</string>
    <string id="RezeroPrompt">Verwirft den Referenzdruck der Oberfläche und das Maximum und misst von vorn. Schaltet sich selbst wieder aus. Nutze das, wenn die Aktivität begann, während die Uhr schon im Wasser war.</string>

    <string id="FieldLabel">Max. Tiefe</string>

    <string id="DiveThresholdTitle">Tauchschwelle</string>
    <string id="DiveThresholdPrompt">Ab welcher Tiefe ein Tauchgang zählt – für Anzahl und Grundzeit in der Aktivität. Ein Tauchgang endet, sobald du wieder über die Hälfte dieser Tiefe steigst, damit Dümpeln an der Oberfläche nicht als Tauchen zählt.</string>
    <string id="DiveThreshold05">0.5 m (1.6 ft)</string>
    <string id="DiveThreshold10">1.0 m (3.3 ft)</string>
    <string id="DiveThreshold15">1.5 m (4.9 ft)</string>
    <string id="DiveThreshold20">2.0 m (6.6 ft)</string>
    <string id="DiveThreshold30">3.0 m (9.8 ft)</string>
</strings>
