    <iq:barrels/>
    <!--
            No annotations are declared here on purpose. (:glance) is a build
            exclusion applied by the consuming app, not a barrel annotation, so
            it needs no declaration - it is honoured on barrel code as it is.

            The app's glance does not compile without it: dropping it fails
            the build with "Value 'DepthModel' not available in all function
            scopes". The two data fields have no glance, so they each emit a
            harmless "(:glance) annotation will be ignored" warning at build
            time. That is the price of one shared copy, and it is the right
            trade - the alternative is three copies again.
        -->
    <iq:annotations/>
  </iq:barrel>
</iq:manifest>
